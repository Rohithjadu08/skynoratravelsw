# Copy this file to .env and fill in real values. Do NOT commit .env to version control.
# Example environment variables for SKY NORA TRAVELS backend
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# Supabase Credentials (PostgreSQL Database)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# JWT Auth Secrets
JWT_SECRET_KEY=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Twilio OTP (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_SERVICE_SID=VAXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Duffel Air (server-side only)
DUFFEL_ACCESS_TOKEN=duffel_test_your_access_token

# Anthropic AI Key (for AI Travel Assistant)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
